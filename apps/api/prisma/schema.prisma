generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CUSTOMER
  ADMIN
  SUPPLIER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
  OTHER
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum PrintRequestStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum ServiceRequestStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  SHIPPED
  RECEIVED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses              Address[]
  cart                   Cart?
  orders                 Order[]
  suppliedProducts       Product[]        @relation("SupplierProducts")
  stockMovements         StockMovement[]  @relation("StockActor")
  printRequests          PrintRequest[]
  serviceRequests        ServiceRequest[]
  adminPurchaseOrders    PurchaseOrder[]  @relation("AdminPOs")
  supplierPurchaseOrders PurchaseOrder[]  @relation("SupplierPOs")
}

model Address {
  id            String  @id @default(cuid())
  userId        String
  label         String?
  recipientName String
  phone         String
  street        String  @db.Text
  city          String
  province      String
  postalCode    String?
  isDefault     Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  categoryId  String
  supplierId  String?
  sku         String   @unique
  name        String
  description String?  @db.Text
  unit        String   @default("pcs")
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  minStock    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category           Category            @relation(fields: [categoryId], references: [id])
  supplier           User?               @relation("SupplierProducts", fields: [supplierId], references: [id], onDelete: SetNull)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  shippingAddress String        @db.Text
  subtotal        Decimal       @db.Decimal(12, 2)
  shippingCost    Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  transactionRef String?       @unique
  proofUrl       String?       @db.Text
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  actorId   String?
  type      StockMovementType
  quantity  Int
  note      String?           @db.Text
  createdAt DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id])
  actor   User?   @relation("StockActor", fields: [actorId], references: [id], onDelete: SetNull)
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  adminId     String
  supplierId  String
  status      PurchaseOrderStatus @default(SUBMITTED)
  totalCost   Decimal             @db.Decimal(12, 2)
  notes       String?             @db.Text
  trackingRef String?
  shippedAt   DateTime?
  receivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  admin    User                @relation("AdminPOs", fields: [adminId], references: [id])
  supplier User                @relation("SupplierPOs", fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id        String  @id @default(cuid())
  poId      String
  productId String
  quantity  Int
  unitCost  Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])
}

model PrintService {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  basePrice   Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  requests PrintRequest[]
}

model PrintRequest {
  id             String             @id @default(cuid())
  userId         String
  serviceId      String
  title          String
  fileUrl        String?            @db.Text
  copies         Int                @default(1)
  pageCount      Int?
  colorMode      String?
  paperSize      String?
  notes          String?            @db.Text
  estimatedPrice Decimal?           @db.Decimal(12, 2)
  status         PrintRequestStatus @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user    User         @relation(fields: [userId], references: [id])
  service PrintService @relation(fields: [serviceId], references: [id])
}

model ServiceType {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  basePrice   Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  requests ServiceRequest[]
}

model ServiceRequest {
  id                 String               @id @default(cuid())
  userId             String
  serviceTypeId      String
  machineBrand       String
  machineModel       String?
  machineSerial      String?
  problemDescription String               @db.Text
  serviceAddress     String               @db.Text
  preferredAt        DateTime?
  estimatedCost      Decimal?             @db.Decimal(12, 2)
  finalCost          Decimal?             @db.Decimal(12, 2)
  status             ServiceRequestStatus @default(PENDING)
  notes              String?              @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])
}
